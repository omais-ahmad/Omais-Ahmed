# Copy to .env.local for local development. Never commit real values of secrets.
# Everything prefixed VITE_ is bundled into the public site, so only public identifiers belong here.

# --- Supabase (admin dashboard, live content, contact message storage) ---
# Project Settings -> API. The anon key is a public identifier; row level security
# in supabase/migrations/0001_init.sql is what protects the data.
# NEVER put the service_role key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- EmailJS (optional email notification for the contact form) ---
# From the EmailJS dashboard: Account -> Public Key, Email Services, Email Templates.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# --- Deployment ---
# Public origin, used for canonical links and the sitemap. Netlify builds set it automatically.
VITE_SITE_URL=
# Only when the site is served from a sub-path, e.g. /repo/. Leave blank on Netlify.
VITE_BASE_PATH=
